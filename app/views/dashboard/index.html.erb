<div class="min-h-screen bg-slate-950 text-slate-100">
  <header class="border-b border-slate-800/80 bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <span class="text-xl font-black tracking-wider text-emerald-400">WAHUI</span>
      <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "text-sm font-medium text-slate-300 hover:text-white transition-colors" %>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 py-12">
    <p class="text-sm uppercase tracking-widest text-emerald-400">Player dashboard</p>
    <h1 class="mt-3 text-3xl font-bold">Welcome, <%= current_user.email %></h1>
    <p class="mt-2 text-slate-400">Your Wahui account is ready.</p>
  </main>
</div>
