<% content_for :title, "Boards | Wahui" %>

<div class="min-h-screen w-full bg-slate-950 text-slate-100">
  <header class="sticky top-0 z-30 border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <%= link_to "WAHUI", root_path, class: "text-xl font-black tracking-wider text-emerald-400" %>
      <nav class="flex items-center gap-4">
        <%= link_to "Home", root_path, class: "text-sm font-medium text-slate-400 transition-colors hover:text-white" %>
        <%= link_to "Log In", new_user_session_path, class: "text-sm font-medium text-slate-300 transition-colors hover:text-white" %>
        <%= link_to "Get Started", new_user_registration_path, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-500" %>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-6 py-14 sm:py-20">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-400">Board reference</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl">Choose your board.</h1>
      <p class="mt-4 text-base leading-7 text-slate-400">Browse the active Wahui boards and open any card to see the synonyms associated with it.</p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      <% @boards.each do |board| %>
        <%= button_tag type: "button", data: { board_modal_trigger: true, board_number: board.id, board_name: board.name, synonyms: board.synonyms.map(&:word).to_json }, class: "group min-h-36 rounded-2xl border border-slate-800 bg-slate-900/70 p-5 text-left transition-all hover:-translate-y-1 hover:border-emerald-500/60 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/70" do %>
          <span class="font-mono text-xs font-semibold tracking-wider text-slate-500 group-hover:text-emerald-400">#<%= board.id.to_s.rjust(2, "0") %></span>
          <span class="mt-7 block text-base font-bold leading-tight text-white"><%= board.name %></span>
          <span class="mt-2 block text-xs text-slate-500"><%= pluralize(board.synonyms.size, "synonym") %></span>
        <% end %>
      <% end %>
    </div>
  </main>

  <dialog id="board-modal" class="w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-slate-700 bg-slate-900 p-0 text-slate-100 shadow-2xl shadow-black/50 backdrop:bg-slate-950/80">
    <div class="p-6 sm:p-8">
      <div class="flex items-start justify-between gap-5">
        <div>
          <p id="board-modal-number" class="font-mono text-xs font-semibold tracking-wider text-emerald-400"></p>
          <h2 id="board-modal-name" class="mt-2 text-2xl font-bold text-white"></h2>
        </div>
        <button type="button" data-board-modal-close aria-label="Close board synonyms" class="rounded-lg p-2 text-slate-400 transition-colors hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">&times;</button>
      </div>

      <div class="mt-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Synonyms</p>
        <div id="board-modal-synonyms" class="mt-3 flex max-h-64 flex-wrap gap-2 overflow-y-auto"></div>
      </div>
    </div>
  </dialog>
</div>

<script>
  (() => {
    const modal = document.getElementById("board-modal");
    if (!modal) return;

    const number = document.getElementById("board-modal-number");
    const name = document.getElementById("board-modal-name");
    const synonyms = document.getElementById("board-modal-synonyms");

    document.querySelectorAll("[data-board-modal-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        number.textContent = `BOARD #${trigger.dataset.boardNumber.padStart(2, "0")}`;
        name.textContent = trigger.dataset.boardName;
        synonyms.replaceChildren();

        JSON.parse(trigger.dataset.synonyms).forEach((word) => {
          const chip = document.createElement("span");
          chip.className = "rounded-full border border-slate-700 bg-slate-950 px-3 py-1.5 text-sm text-slate-300";
          chip.textContent = word;
          synonyms.appendChild(chip);
        });

        modal.showModal();
      });
    });

    document.querySelector("[data-board-modal-close]").addEventListener("click", () => modal.close());
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  })();
</script>
