<section class="relative overflow-hidden py-24 lg:py-32">
  <!-- Glow background elements -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6">
      The Next Generation <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Wahui Experience</span>
    </h1>
    <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
      A high-performance, modular monolithic gaming platform designed for seamless boards, instantaneous betting dynamics, and secure wallets.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <%= link_to "How to Play", how_to_play_path, class: "w-full sm:w-auto px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-lg shadow-emerald-600/20 transition-all" %>
      <%= link_to "Explore Boards", boards_path, class: "w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold border border-slate-800 transition-all" %>
    </div>
  </div>
</section>
