<aside class="w-64 bg-gray-900 border-r border-gray-800 flex flex-col min-h-screen">
  <!-- Brand Header -->
  <div class="h-16 flex items-center px-6 border-b border-gray-800">
    <%= link_to "WAHUI // ADMIN", admin_root_path, class: "text-lg font-black tracking-wider text-emerald-400" %>
  </div>

  <!-- Navigation Links -->
  <nav class="flex-1 px-4 py-6 space-y-1">
    <%= link_to admin_root_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors #{current_page?(admin_root_path) ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-gray-400 hover:text-white hover:bg-gray-800/50'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      Dashboard
    <% end %>

    <%= link_to admin_boards_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors #{controller_name == 'boards' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-gray-400 hover:text-white hover:bg-gray-800/50'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      Game Boards
    <% end %>

    <%= link_to admin_transactions_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors #{controller_name == 'transactions' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-gray-400 hover:text-white hover:bg-gray-800/50'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Transactions & Ledger
    <% end %>

    <%= link_to admin_users_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors #{controller_name == 'users' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'text-gray-400 hover:text-white hover:bg-gray-800/50'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      Users & Roles
    <% end %>
  </nav>

  <!-- Footer Profile / Logout -->
  <div class="p-4 border-t border-gray-800">
    <div class="flex items-center justify-between mb-3 px-2">
      <span class="text-xs text-gray-400 truncate max-w-[140px]"><%= Current.user&.email %></span>
      <span class="px-2 py-0.5 text-[10px] uppercase font-bold bg-emerald-500/20 text-emerald-400 rounded"><%= Current.user&.role %></span>
    </div>
    <%= button_to "Sign Out", logout_path, method: :delete, 
        class: "w-full text-center text-xs font-medium bg-gray-800 hover:bg-gray-700 text-gray-300 py-2 rounded-lg transition-colors cursor-pointer" %>
  </div>
</aside>
