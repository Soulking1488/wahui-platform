<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm uppercase tracking-wider text-emerald-400">Round management</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Wahui rounds</h2>
    </div>
    <%= link_to "New draft round", new_admin_wahuiboard_path, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
  </div>

  <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "All (#{@status_summary['all']})", admin_wahuiboards_path(status: "all"), class: "rounded-full px-3 py-1.5 text-xs font-medium #{'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' if @status_filter == 'all'} #{'bg-gray-800 text-gray-300 border border-gray-700' unless @status_filter == 'all'}" %>
      <% Wahuiboard.statuses.keys.each do |status| %>
        <%= link_to "#{status.humanize} (#{@status_summary[status]})", admin_wahuiboards_path(status: status), class: "rounded-full px-3 py-1.5 text-xs font-medium #{'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' if @status_filter == status} #{'bg-gray-800 text-gray-300 border border-gray-700' unless @status_filter == status}" %>
      <% end %>
    </div>
  </div>

  <div class="overflow-hidden rounded-xl border border-gray-800 bg-gray-900 shadow-xl shadow-black/10">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-800">
        <thead class="bg-gray-800/60">
          <tr>
            <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-gray-500">#</th>
            <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-gray-500">Title</th>
            <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-gray-500">Board</th>
            <th class="px-6 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-gray-500">Status</th>
            <th class="px-6 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/80">
          <% @wahuiboards.each do |round| %>
            <tr class="transition-colors hover:bg-gray-800/40">
              <td class="whitespace-nowrap px-6 py-3.5 text-sm font-mono text-gray-500">#<%= round.public_number %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm font-medium text-white"><%= round.title %></td>
              <td class="whitespace-nowrap px-6 py-3.5 text-sm text-gray-300"><%= round.board&.name || "Unassigned" %></td>
              <td class="whitespace-nowrap px-6 py-3.5">
                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium bg-emerald-500/10 text-emerald-300"><%= round.status %></span>
              </td>
              <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm">
                <%= link_to "View", admin_wahuiboard_path(round), class: "text-gray-400 hover:text-white" %>
                <%= link_to "Edit", edit_admin_wahuiboard_path(round), class: "ml-4 font-medium text-emerald-400 hover:text-emerald-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @wahuiboards.empty? %>
      <div class="px-6 py-12 text-center text-sm text-gray-500">No rounds have been created yet.</div>
    <% end %>
  </div>
</div>
