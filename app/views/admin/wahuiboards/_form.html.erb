<%= form_with model: [:admin, wahuiboard], class: "space-y-6 rounded-xl border border-gray-800 bg-gray-900 p-6" do |form| %>
  <% if wahuiboard.errors.any? %>
    <div class="rounded-lg border border-red-800 bg-red-950/50 p-4 text-sm text-red-200">
      <%= wahuiboard.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <%= form.label :title, class: "block text-sm font-medium text-gray-300" %>
      <%= form.text_field :title, required: true, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :public_number, class: "block text-sm font-medium text-gray-300" %>
      <%= form.number_field :public_number, required: true, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :board_id, "Winning board", class: "block text-sm font-medium text-gray-300" %>
      <%= form.select :board_id, Board.order(:name).map { |board| [board.name, board.id] }, { include_blank: "Select winning board" }, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-300" %>
      <%= form.select :status, Wahuiboard.statuses.keys.map { |key| [key.humanize, key] }, {}, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :opens_at, class: "block text-sm font-medium text-gray-300" %>
      <%= form.datetime_local_field :opens_at, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :betting_closing_time, class: "block text-sm font-medium text-gray-300" %>
      <%= form.datetime_local_field :betting_closing_time, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :announcement_time, class: "block text-sm font-medium text-gray-300" %>
      <%= form.datetime_local_field :announcement_time, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :house_bet_amount, class: "block text-sm font-medium text-gray-300" %>
      <%= form.number_field :house_bet_amount, step: "0.01", min: 0, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <div class="space-y-4 rounded-xl border border-emerald-900/30 bg-emerald-950/10 p-4">
    <div>
      <p class="text-sm font-medium text-emerald-300">Pantun / clue lines</p>
      <p class="mt-1 text-xs text-gray-400">Enter the exact 4-line clue for this round. These are stored with the round and should not be edited after publication.</p>
    </div>

    <div>
      <%= form.label :clue_1, "Line 1", class: "block text-sm font-medium text-gray-300" %>
      <%= form.text_area :clue_1, rows: 2, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :clue_2, "Line 2", class: "block text-sm font-medium text-gray-300" %>
      <%= form.text_area :clue_2, rows: 2, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :clue_3, "Line 3", class: "block text-sm font-medium text-gray-300" %>
      <%= form.text_area :clue_3, rows: 2, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :clue_4, "Line 4", class: "block text-sm font-medium text-gray-300" %>
      <%= form.text_area :clue_4, rows: 2, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-300" %>
    <%= form.text_area :description, rows: 4, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit "Save draft", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
    <%= link_to "Cancel", admin_wahuiboards_path, class: "text-sm text-gray-400 hover:text-white" %>
  </div>
<% end %>
