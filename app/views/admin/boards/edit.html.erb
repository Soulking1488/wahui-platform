<div class="max-w-2xl space-y-6">
  <div>
    <p class="text-sm uppercase tracking-wider text-emerald-400">Board management</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Edit <%= @board.name %></h2>
  </div>

  <%= form_with model: [:admin, @board], class: "space-y-6 rounded-xl border border-gray-800 bg-gray-900 p-6" do |form| %>
    <% if @board.errors.any? %>
      <div class="rounded-lg border border-red-800 bg-red-950/50 p-4 text-sm text-red-200">
        <%= @board.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-300" %>
      <%= form.text_field :name, required: true, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <label class="flex items-center gap-3 text-sm text-gray-300">
      <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-600 bg-gray-950 text-emerald-500 focus:ring-emerald-500" %>
      Available for future rounds
    </label>

    <div class="flex items-center gap-4">
      <%= form.submit "Save changes", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
      <%= link_to "Cancel", admin_board_path(@board), class: "text-sm text-gray-400 hover:text-white" %>
    </div>
  <% end %>
</div>
