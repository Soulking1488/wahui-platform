<%= form_with model: [:admin, @board, @synonym], class: "space-y-6 rounded-xl border border-gray-800 bg-gray-900 p-6" do |form| %>
  <% if @synonym.errors.any? %>
    <div class="rounded-lg border border-red-800 bg-red-950/50 p-4 text-sm text-red-200">
      <%= @synonym.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :word, "Synonym", class: "block text-sm font-medium text-gray-300" %>
    <%= form.text_field :word, required: true, autofocus: true, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :mapping, "Mapping", class: "block text-sm font-medium text-gray-300" %>
    <%= form.text_field :mapping, class: "mt-2 block w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    <p class="mt-2 text-xs text-gray-500">Optional context or source label for this synonym.</p>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit "Save synonym", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
    <%= link_to "Cancel", admin_board_synonyms_path(@board), class: "text-sm text-gray-400 hover:text-white" %>
  </div>
<% end %>
